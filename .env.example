# Copy these into Vercel → Project → Settings → Environment Variables (all environments).

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # secret — server only

# Razorpay (Dashboard → Account & Settings → API Keys). Use test keys first.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxxxxxxx             # secret — server only

# Anthropic (console.anthropic.com → API Keys) — reads plan and bill photos for Pro users
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5-5
